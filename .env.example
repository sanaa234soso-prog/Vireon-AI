# VIREON Environment Variables Configuration

# Application URL
APP_URL="MY_APP_URL"

# ==============================================================================
# EMAIL & OTP AUTHENTICATION (Gmail App Password & SMTP)
# ==============================================================================
# Official sender email (e.g. your Gmail address)
EMAIL_FROM_ADDRESS="vireon.partners1@gmail.com"
EMAIL_FROM_NAME="VIREON Platform"

# Google App Password (16 characters from Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_USER="vireon.partners1@gmail.com"
GMAIL_APP_PASSWORD=""

# Custom SMTP Configuration (Optional: defaults to smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# ==============================================================================
# SUPABASE & DATABASE CONFIGURATION (Optional)
# ==============================================================================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# PostgreSQL / Supabase Connection String (Direct or Pooler)
DATABASE_URL="postgres://user:password@ep-sample-pooler.neon.tech/neondb?sslmode=require"

# ==============================================================================
# PAYMENTS & ESCROW (WHOP)
# ==============================================================================
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_COMPANY_ID=""
